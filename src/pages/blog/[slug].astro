---
import { getCollection, render } from "astro:content";
import ArticleMedia from "../../components/ArticleMedia.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ui } from "../../i18n/ui";
import { findTranslation, formatDate } from "../../i18n/utils";

export async function getStaticPaths() {
  const entries = await getCollection("blog");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    // Posts in both languages share /blog/, so the counterpart is resolved
    // here rather than by URL prefix.
    props: { entry, translation: findTranslation(entry, entries) },
  }));
}

const { entry, translation } = Astro.props;
const { Content } = await render(entry);
const ISODate = entry.data.date.toISOString();
const lang = entry.data.language;

const alternate = translation
  ? { lang: translation.data.language, href: `/blog/${translation.id}` }
  : undefined;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  article={{ tags: entry.data.tags, date: ISODate }}
  lang={lang}
  alternate={alternate}
>
  <h1 class="text-4xl mt-20">
    {entry.data.title}
  </h1>
  <div class="text-[#EEEEE2]/60 mb-10 text-sm mt-2 flex flex-col space-y-1">
    <div class="flex items-center space-x-2">
      <i class="ri-calendar-line"></i>
      <time datetime={ISODate}>{formatDate(entry.data.date, lang)}</time>
    </div>
    <div class="flex items-center space-x-2">
      <i class="ri-price-tag-3-line"></i>
      <span>
        {entry.data.tags.join(" - ")}
      </span>
    </div>
    {
      alternate && (
        <a
          class="flex items-center space-x-2 w-fit hover:text-[#EEEEE2] transition-all"
          href={alternate.href}
          hreflang={alternate.lang}
          lang={alternate.lang}
          data-set-lang={alternate.lang}
        >
          <i class="ri-translate-2" />
          <span>{ui[alternate.lang]["lang.readIn"]}</span>
        </a>
      )
    }
  </div>
  <article
    class="prose max-w-none mb-10 prose-headings:font-semibold prose-headings:tracking-tight prose-h1:text-2xl prose-h1:mt-10 prose-h1:mb-3 prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-3 prose-h3:text-lg prose-h3:mt-8 prose-h3:mb-2 prose-a:font-medium prose-a:underline-offset-4 prose-blockquote:not-italic prose-blockquote:font-normal prose-code:before:content-none prose-code:after:content-none"
  >
    <Content />
  </article>
  <ArticleMedia />
  <div class="giscus mb-10"></div>
  <script
    is:inline
    src="https://giscus.app/client.js"
    data-repo="ga1az/portafolio"
    data-repo-id="R_kgDOLZgY8w"
    data-category="Announcements"
    data-category-id="DIC_kwDOLZgY884CkkYG"
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="bottom"
    data-theme="dark"
    data-lang={lang}
    crossorigin="anonymous"
    async></script>
</BaseLayout>
