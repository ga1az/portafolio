---
/**
 * The Spanish archive moved to /es/blog. This is a client redirect rather
 * than an entry in `redirects` because the Vercel adapter matches the exact
 * path only: "/blog/es" would 301 while "/blog/es/" — the form the old
 * sitemap advertised — would 404. A static page answers both.
 */
const destination = "/es/blog";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0; url=${destination}`} />
    <link rel="canonical" href={new URL(`${destination}/`, Astro.site)} />
    <title>Blog - Sergio Galaz</title>
  </head>
  <body>
    <a href={destination}>Blog</a>
  </body>
</html>
