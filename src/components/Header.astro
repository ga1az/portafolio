---
import { cn } from "../libs/utils";
import { NAV } from "../constants";
import type { Lang } from "../i18n/ui";
import { ui } from "../i18n/ui";
import { isActivePath, localizePath, useTranslations } from "../i18n/utils";

export type Props = {
  lang: Lang;
  /** Where the language switch goes: same content when it exists. */
  switchTarget: { lang: Lang; href: string };
};

const { lang, switchTarget } = Astro.props;
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;
---

<header class="flex space-x-2 text-lg">
  {
    NAV.map((item) => {
      const href = localizePath(lang, item.href);
      return (
        <a
          class={cn(
            "cursor-pointer hover:text-[#EEEEE2]/60 transition-all lowercase",
            isActivePath(currentPath, href) && "text-[#EEEEE2]/60"
          )}
          href={href}
        >
          {t(item.key)}
        </a>
      );
    })
  }

  {/* The other edition of this page. Sits apart from the sections on purpose. */}
  <a
    class="ml-auto cursor-pointer text-[#EEEEE2]/60 hover:text-[#EEEEE2] transition-all lowercase"
    href={switchTarget.href}
    hreflang={switchTarget.lang}
    lang={switchTarget.lang}
    title={ui[switchTarget.lang]["lang.readIn"]}
    data-set-lang={switchTarget.lang}
  >
    {ui[switchTarget.lang]["lang.name"]}
  </a>
</header>
